# Private development repository. Code, configuration and scripts are tracked;
# datasets, run outputs, manuscripts and reports stay local.

/*
!/.gitignore
!/README.md
!/requirements.txt
!/config/
!/src/
!/scripts/
!/data/
!/paper/
!/splits/
!/scratch/
!/notes/

# data/: generation, processing and inspection code only
/data/*
!/data/*.py
!/data/utils/

# paper/: table and figure scripts only
/paper/*
!/paper/scripts/

# scratch/: launch and analysis scripts only
/scratch/**
!/scratch/**/
!/scratch/**/*.py
!/scratch/**/*.sh

*.bak
__pycache__/
*.py[cod]
*.log
*.out
*.wandb
*.pt
*.pth
*.ckpt
*.pkl
*.npy
*.npz
*.h5
*.pdf
*.png
*.zip
